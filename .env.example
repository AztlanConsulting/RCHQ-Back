# Development
RUNNING_PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/databasename

# 32-byte key: openssl rand -hex 32  (writes 64 hex chars), or openssl rand -base64 32
ENCRYPTION_KEY=

# Services
JWT_SECRET=yoursecrethere
MAILGUN_KEY=your-mailgun-key
LOG_IP_HASH_SECRET=yoursecrethere

# Ambient
NODE_ENV=production

MAILGUN_KEY=AAA
MAIL_SENDER=no_reply
MAIL_SUFFIX=mails
DOMAIN=example.xom

ALLOWED_ORIGINS=http://localhost:3000,https://miapp.com,https://admin.miapp.com
