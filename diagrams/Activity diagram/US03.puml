@startuml

|Usuario|
start
:Entrar a "cambiar contraseña";
:Introducir contraseña actual, nueva y confirmación;

|Sistema|
:Validar formato de datos;
if (¿Datos válidos?) then (Sí)
else (No)
  :Mostrar error de validación;
  stop
endif

:Validar sesión/autenticación;
if (¿Usuario autenticado?) then (Sí)
else (No)
  :Mostrar error de acceso no autorizado;
  stop
endif

:Buscar usuario por ID;
if (¿Usuario existe?) then (Sí)
else (No)
  :Mostrar usuario no encontrado;
  stop
endif

if (¿Cuenta activa?) then (Sí)
else (No)
  :Guardar log de intento con cuenta inactiva;
  :Mostrar acceso no permitido;
  stop
endif

if (¿Confirmación coincide?) then (Sí)
else (No)
  :Mostrar error de confirmación;
  stop
endif

:Comparar contraseña actual ingresada con la guardada;
if (¿Contraseña actual correcta?) then (Sí)
else (No)
  :Guardar log de intento fallido de cambio;
  :Mostrar credenciales inválidas;
  stop
endif

:Comparar nueva contraseña con la actual;
if (¿Nueva contraseña es diferente?) then (Sí)
else (No)
  :Mostrar error: la nueva contraseña debe ser diferente;
  stop
endif

:Hashear nueva contraseña;
:Actualizar contraseña en BD;
:Guardar log de cambio de contraseña exitoso;
:Mostrar mensaje de éxito;

|Usuario|
:Continuar usando la app;
stop

@enduml