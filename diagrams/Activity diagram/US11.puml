@startuml
title US 11 - Ver información de un trabajador específico (Activity Diagram)

|Usuario|
start
:Selecciona a un empleado para ver su detalle;

|Frontend|
:Envía solicitud GET /employee-detail/:employeeId al backend;

|API|
:Recibe solicitud en el router;
:Ejecuta middleware apiLimiter y verifyToken;
if (¿Token válido?) then (Sí)
  :Ejecuta middleware requireRole("Administrador", "Coordinador");
  if (¿Tiene rol correcto?) then (Sí)
    :Ejecuta middleware requirePrivileges("viewEmployees");
    if (¿Tiene privilegio?) then (Sí)
      :Ejecuta middleware ABAC authorize(employeePolicy);
      if (¿Está autorizado para ver a este empleado?) then (Sí)
        :Delega al Controller (getEmployeeDetail);
        :Delega al Service (getEmployeeDetail);
        :Busca info básica del empleado (getEmployeeById);
        if (¿Empleado existe?) then (Sí)
          :Desencripta el salario del empleado;
          :Busca dirección (getEmployeeAddress);
          :Busca datos de la casa (getHouseById);
          :Busca días laborales (getEmployeeWorkdays);
          :Busca solicitudes de vacaciones (getEmployeeVacationRequests);
          :Calcula días usados de ausencias justificadas (calculateMonthlyJustifiedAbsenceUsedDays);
          :Agrupa toda la información (basicInfo, adminInfo);
          :Retorna status 200 con todos los datos del empleado;
        else (No)
          :Retorna status 404 (Empleado no encontrado);
        endif
      else (No)
        :Retorna status 403 (No autorizado por política ABAC);
      endif
    else (No)
      :Retorna status 403 (Privilegio insuficiente);
    endif
  else (No)
    :Retorna status 403 (Rol insuficiente);
  endif
else (No)
  :Retorna status 401 (No autenticado);
endif

|Frontend|
:Muestra la pantalla de detalle con toda la información cargada;
stop
@enduml
