@startuml

|Empleado|
start
:Ingresa a sus vacaciones;
:Abre el detalle de una solicitud pendiente;
:Presiona editar;
:Selecciona nuevas fechas;
:Presiona guardar;

|Sistema|
:Valida id de solicitud y formato\nde fechas YYYY-MM-DD;

if (¿Datos validos?) then (Si)
else (No)
:Muestra mensaje de datos invalidos;
stop
endif

:Obtiene al empleado autenticado;

if (¿Empleado autenticado existe?) then (Si)
else (No)
:Muestra mensaje de usuario no autenticado;
stop
endif

:Convierte las nuevas fechas;

if (¿Fecha inicio es posterior a fecha fin?) then (Si)
:Muestra mensaje de fechas invalidas;
stop
else (No)
endif

:Obtiene la solicitud de vacaciones;

if (¿Solicitud existe?) then (Si)
else (No)
:Muestra mensaje de solicitud no encontrada;
stop
endif

if (¿Solicitud original o nueva fecha ya empezo?) then (Si)
:Muestra mensaje de que no se pueden modificar\nvacaciones que ya comenzaron;
stop
else (No)
endif

if (¿Empleado es dueño de la solicitud?) then (Si)
else (No)
:Muestra mensaje de permisos insuficientes;
stop
endif

if (¿Solicitud esta pendiente?) then (Si)
else (No)
:Muestra mensaje de que solo puede modificar\nsolicitudes pendientes;
stop
endif

:Obtiene periodo actual de vacaciones;

if (¿Fechas estan dentro del periodo actual?) then (Si)
else (No)
:Muestra mensaje de que no se pueden modificar\nvacaciones fuera del periodo actual;
stop
endif

:Obtiene dias de trabajo del empleado;

if (¿Empleado tiene dias de trabajo?) then (Si)
else (No)
:Muestra mensaje de que se necesitan\ndias de trabajo registrados;
stop
endif

:Obtiene eventos globales y de casa;
:Filtra eventos marcados como dia libre;
:Calcula dias habiles reales a usar;

if (¿Rango tiene dias habiles?) then (Si)
else (No)
:Muestra mensaje de que no hay ningun\ndia habil de vacaciones;
stop
endif

:Actualiza la solicitud dentro de una transaccion;
:Bloquea el empleado para evitar empalmes;
:Verifica que no exista otra solicitud activa empalmada;

if (¿Existe solicitud activa empalmada?) then (Si)
:Muestra mensaje de que ya existe una solicitud\ncubriendo los dias solicitados;
stop
else (No)
endif

:Suma dias usados del periodo actual\nexcluyendo la solicitud actual;

if (¿Tiene dias suficientes?) then (Si)
else (No)
:Muestra mensaje de dias de vacaciones insuficientes;
stop
endif

:Actualiza fechas y dias usados;
:Registra log de modificacion exitosa;
:Muestra mensaje de vacaciones modificadas correctamente;
stop

@enduml
