@startuml
title US34 - Registrar solicitud de vacaciones

|Empleado|
start
:Entra al módulo para solicitar vacaciones;
:Selecciona fecha de inicio;
:Selecciona fecha final;
:Envía solicitud de vacaciones;

|Sistema|
:Validar token de sesión;
if (¿Usuario autenticado?) then (Sí)
else (No)
:Mostrar error "Token no proporcionado o inválido";
stop
endif

:Aplicar rate limit;
:Resolver casa hogar del solicitante;

:Validar formato de fechas YYYY-MM-DD;
if (¿Fechas válidas?) then (Sí)
  :Convertir fechas a UTC;
else (No)
  :Mostrar error "Las fechas son requeridas y tienen que estar en formato YYYY-MM-DD";
  stop
endif

:Validar que fecha final no sea anterior a fecha inicial;
if (¿Fecha final >= fecha inicial?) then (Sí)
else (No)
  :Mostrar error "No se puede tener una fecha de inicio posterior a la de finalización";
  stop
endif

:Obtener días laborales del empleado;
if (¿Empleado tiene días laborales registrados?) then (Sí)
else (No)
  :Mostrar error "Se necesitan tener registrados los días de trabajo";
  stop
endif

:Obtener días de vacaciones disponibles y periodo laboral vigente;
if (¿Rango solicitado pertenece al periodo laboral vigente?) then (Sí)
else (No)
  :Mostrar error "No se pueden solicitar vacaciones fuera del periodo actual de trabajo";
  stop
endif

:Validar que fecha inicial sea posterior a hoy;
if (¿Fecha inicial > hoy?) then (Sí)
else (No)
  :Mostrar error "No se pueden pedir vacaciones en el pasado ni para el mismo día";
  stop
endif

:Obtener eventos globales y de casa del rango solicitado;
:Filtrar días libres;
:Calcular días hábiles de vacaciones;
if (¿El rango consume al menos un día hábil?) then (Sí)
else (No)
  :Mostrar error "Dentro del rango seleccionado no hay ningún día hábil de vacaciones";
  stop
endif

:Validar días disponibles actuales;
if (¿Días solicitados <= días disponibles?) then (Sí)
else (No)
  :Mostrar error "No se tienen suficientes días disponibles para solicitar las vacaciones";
  stop
endif

:Buscar vacaciones activas traslapadas;
note right
Se revisan vacaciones:
- dentro del rango solicitado
- fuera del rango solicitado pero traslapadas

Se consideran activas:
- pendientes
- aprobadas
end note

if (¿Existe traslape?) then (Sí)
  :Mostrar error "Ya hay una solicitud de vacaciones cubriendo los días solicitados";
  stop
else (No)
endif

:Crear registro en vacations_request con status = PENDING;
:Guardar used_days;
:Guardar created_at;
:Crear log de auditoría;
:Mostrar confirmación "Se solicitaron las vacaciones de forma correcta";

|Empleado|
:Visualiza confirmación en pantalla;
stop

@enduml
