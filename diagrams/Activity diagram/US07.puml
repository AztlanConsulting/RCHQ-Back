@startuml
title US - Consultar Documentos de Empleado (Activity Diagram)

|Usuario|
start
:Navega a la pestaña de Documentos de un empleado (o propios);

|Frontend|
:Obtiene el token de sesión almacenado;
:Envía solicitud GET /:id/documents al backend;

|API|
:Recibe solicitud en el router;
:Ejecuta middleware de rate limit (apiLimiter);
:Ejecuta middleware de autenticación (verifyToken);

if (¿Token es válido?) then (Sí)
  :Ejecuta middleware requirePrivileges("viewDocuments");
  if (¿Tiene el privilegio general?) then (Sí)
    :Ejecuta resolver "resolveEmployeeHouse";
    :Busca la casa del empleado en la BD;
    if (¿El empleado existe para resolver su casa?) then (Sí)
      :Asigna houseId a req.resolvedEmployee;
      :Ejecuta middleware ABAC authorize(viewDocuments);
      
      if (¿Es el mismo usuario, es Admin, o pertenece a la misma casa con rol permitido?) then (Sí)
        :Delega al Controller y Service;
        :Busca al empleado en BD por ID;
        
        if (¿Empleado encontrado en Service?) then (Sí)
          :Busca la lista de documentos en BD;
          if (¿Tiene documentos registrados?) then (Sí)
            :Mapea la lista de documentos (id, nombre, url);
            :Retorna status 200 con la lista de documentos (DOCUMENTS.OK);
          else (No)
            :Retorna status 200 con array vacío (DOCUMENTS.NOT_FOUND);
          endif
        else (No)
          :Retorna status 404 (USER.NOT_FOUND);
        endif
        
      else (No)
        :Retorna status 403 (No autorizado por política ABAC);
      endif
    else (No)
      :Retorna status 404 (Empleado no encontrado en resolver);
    endif
  else (No)
    :Retorna status 403 (Privilegio insuficiente);
  endif
else (No)
  :Retorna status 401 / 403 (Token inválido);
endif

|Frontend|
:Recibe respuesta HTTP;
:Renderiza lista de documentos, tabla vacía o mensaje de error según status;
stop

@enduml
