@startuml
title US 06 - Mantener inicio de sesion seguro

|Usuario|
start
:Navega en la aplicacion;

|Frontend|
:Envia una peticion protegida con accessToken;

|Backend|
if (La peticion responde 401?) then (Si)
else (No)
    :Retorna la respuesta normal;
    |Usuario|
    stop
endif

|Frontend|
:secureFetchWrapper detecta 401;
if (Ya hay un refresh en curso?) then (Si)
    :Espera el refresh compartido;
else (No)
    :Inicia POST /auth/refresh;
endif

|Backend|
:El navegador envia la cookie HttpOnly automaticamente;
:Aplica apiLimiter;
:auth.controller.js extrae req.cookies.refreshToken;

if (Existe refreshToken en la cookie?) then (Si)
    :jwt.js decodifica y verifica firma;
    if (Token valido y tokenType == "REFRESH"?) then (Si)
        :auth.model.js busca empleado por ID;
        if (Empleado existe y esta activo?) then (Si)
            if (refreshToken coincide con el guardado en BD?) then (Si)
                :Genera nuevo accessToken SESSION\ncon el mismo sessionId;
                :Conserva el mismo refreshToken;
                :auth.controller.js renueva la cookie HttpOnly;
                :Elimina refreshToken del body de respuesta;
                :Retorna 200 REFRESH_SUCCESS\ncon el nuevo accessToken;
            else (No - token robado o reuso)
                :auth.model.js borra refreshToken en BD;
                :auth.controller.js limpia cookie refreshToken;
                :Retorna 401 INVALID_REFRESH_TOKEN\n(Sesion invalida);
            endif
        else (No)
            :auth.controller.js limpia cookie refreshToken;
            :Retorna 403 INVALID_REFRESH_TOKEN\n(Acceso denegado);
        endif
    else (No)
        :auth.controller.js limpia cookie refreshToken;
        :Retorna 401 INVALID_REFRESH_TOKEN\n(Token expirado o invalido);
    endif
else (No)
    :auth.controller.js limpia cookie refreshToken;
    :Retorna 401 INVALID_REFRESH_TOKEN\n(Token no proporcionado);
endif

|Frontend|
if (Refresh respondio 200?) then (Si)
    :Guarda el nuevo accessToken;
    :Notifica a otras peticiones/pestanas;
    :Reintenta la peticion original\ncon el accessToken nuevo;
else (No)
    :Limpia estado local de autenticacion;
    :Redirige a Login\n(Sesion expirada);
endif

|Usuario|
stop
@enduml
