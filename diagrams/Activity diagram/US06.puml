@startuml
title US 06 - Mantener inicio de sesion seguro y una sola sesion activa

|Usuario|
start

if (Accion del usuario?) then (Iniciar sesion)
    |Frontend|
    :Envia credenciales a /auth/login\no valida 2FA en /auth/2fa/login/validate;

    |Backend|
    :Valida credenciales y estado del empleado;
    if (Login requiere 2FA?) then (Si)
        :Valida codigo TOTP;
    else (No)
    endif

    if (Existe employee_session que bloquea login?) then (Si)
        :Sesion activa, no revocada,\nno expirada y blocks_login_until > now;
        :Retorna 409 SESSION_ALREADY_ACTIVE;

        |Frontend|
        :Muestra mensaje de sesion activa;
        :No inicia nueva sesion;

        |Usuario|
        stop
    else (No)
        :Revoca sesiones antiguas que ya no bloquean login\no que expiraron;
    endif

    :Genera nuevo sessionId;
    :Genera accessToken SESSION con sessionId;
    :Genera refreshToken REFRESH con sessionId;
    :Calcula lastActivityAt,\nblocksLoginUntil y expiresAt;
    :Guarda employee_session activa\ncon hash del refreshToken;
    :Configura cookie HttpOnly refreshToken;
    :Retorna 200 con accessToken;

    |Frontend|
    :Guarda accessToken;
    :Entra a la aplicacion;

else (Usar sesion existente)
    |Frontend|
    :Envia peticion protegida con accessToken;

    |Backend|
    if (La peticion responde 401?) then (Si)
    else (No)
        :Retorna respuesta normal;
        |Usuario|
        stop
    endif

    |Frontend|
    :secureFetchWrapper detecta 401;
    if (Ya hay un refresh en curso?) then (Si)
        :Espera el refresh compartido;
    else (No)
        :Inicia POST /auth/refresh;
    endif

    |Backend|
    :El navegador envia cookie HttpOnly automaticamente;
    :Aplica apiLimiter;
    :auth.controller.js extrae req.cookies.refreshToken;

    if (Existe refreshToken en la cookie?) then (Si)
        :jwt.js decodifica y verifica firma;
        if (Token valido y tokenType == "REFRESH"?) then (Si)
            :auth.model.js busca employee_session\npor hash del refreshToken;
            if (Sesion existe y coincide\ncon sessionId y employeeId?) then (Si)
                if (Sesion renovable?\nis_active, revoked_at null y expires_at > now) then (Si)
                    :Valida que el empleado exista y este activo;
                    if (Empleado activo?) then (Si)
                        :Actualiza lastActivityAt\ny blocksLoginUntil;
                        :Genera nuevo accessToken SESSION\ncon el mismo sessionId;
                        :Conserva el mismo refreshToken;
                        :auth.controller.js renueva cookie HttpOnly;
                        :Elimina refreshToken del body;
                        :Retorna 200 REFRESH_SUCCESS\ncon nuevo accessToken;
                    else (No)
                        :auth.controller.js limpia cookie refreshToken;
                        :Retorna 403 INVALID_REFRESH_TOKEN;
                    endif
                else (No - sesion expirada o revocada)
                    :auth.model.js revoca la sesion;
                    :auth.controller.js limpia cookie refreshToken;
                    :Retorna 401 INVALID_REFRESH_TOKEN;
                endif
            else (No)
                :auth.model.js revoca la sesion si puede identificarla;
                :auth.controller.js limpia cookie refreshToken;
                :Retorna 401 INVALID_REFRESH_TOKEN;
            endif
        else (No)
            :auth.controller.js limpia cookie refreshToken;
            :Retorna 401 INVALID_REFRESH_TOKEN;
        endif
    else (No)
        :auth.controller.js limpia cookie refreshToken;
        :Retorna 401 INVALID_REFRESH_TOKEN;
    endif

    |Frontend|
    if (Refresh respondio 200?) then (Si)
        :Guarda nuevo accessToken;
        :Notifica a otras peticiones/pestanas;
        :Reintenta peticion original\ncon accessToken nuevo;
    else (No)
        :Limpia autenticacion local;
        :Redirige a Login;
    endif
endif

|Usuario|
stop
@enduml
