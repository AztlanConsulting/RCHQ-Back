@startuml
title US34 - Aprobar una solicitud de vacaciones

|Usuario|
start
:Entrar al módulo de solicitudes de vacaciones;
:Seleccionar una solicitud pendiente;
:Dar clic en aprobar solicitud;

|Sistema|
:Aplicar rate limit;
:Validar token de sesión;

if (¿Token válido?) then (Sí)
else (No)
:Mostrar error "Token no proporcionado o inválido";
stop
endif

:Validar rol Admin o Coordinador;

if (¿Rol permitido?) then (Sí)
else (No)
:Mostrar error "Rol no permitido";
stop
endif

:Validar privilegio para gestionar empleados/vacaciones;

if (¿Tiene privilegio?) then (Sí)
else (No)
:Mostrar error "Permisos insuficientes";
stop
endif

:Validar request HTTP con schema;

if (¿Request válida?) then (Sí)
else (No)
:Mostrar error de validación;
stop
endif

:Validar contrato de entrada del caso de uso;

if (¿Entrada válida?) then (Sí)
else (No)
:Mostrar error de validación;
stop
endif

:Buscar solicitud de vacaciones;

if (¿Solicitud existe?) then (Sí)
else (No)
:Mostrar error "Solicitud de vacaciones no encontrada";
stop
endif

if (¿Solicitud sigue pendiente?) then (Sí)
else (No)
:Mostrar error "La solicitud ya fue revisada";
stop
endif

:Buscar empleado dueño de la solicitud;

if (¿Empleado existe?) then (Sí)
else (No)
:Mostrar error "Empleado no encontrado";
stop
endif

if (¿Actor es Admin?) then (Sí)
:Permitir revisión de la solicitud;
else (No)
:Validar que el Coordinador pertenezca a la misma casa hogar que el empleado;

if (¿Misma casa hogar?) then (Sí)
:Permitir revisión de la solicitud;
else (No)
:Mostrar error "No puede acceder a este recurso";
stop
endif
endif

:Iniciar transacción;
:Bloquear operaciones concurrentes de vacaciones del empleado;
:Releer solicitud dentro de la transacción;

if (¿Solicitud sigue pendiente?) then (Sí)
else (No)
:Cancelar aprobación;
:Mostrar error "La solicitud ya fue revisada";
stop
endif

:Obtener periodo laboral vigente del empleado;

if (¿Solicitud pertenece al año laboral permitido?) then (Sí)
else (No)
:Cancelar aprobación;
:Mostrar error "No se pueden aprobar vacaciones fuera del periodo actual de trabajo";
stop
endif

:Obtener días laborales del empleado;

if (¿Empleado tiene días laborales registrados?) then (Sí)
else (No)
:Cancelar aprobación;
:Mostrar error "Se necesitan tener registrados los días de trabajo";
stop
endif

:Obtener eventos globales dentro del rango;
:Recalcular días hábiles usados;

if (¿Consume al menos un día hábil?) then (Sí)
else (No)
:Cancelar aprobación;
:Mostrar error "Dentro del rango seleccionado no hay ningún día hábil de vacaciones";
stop
endif

:Buscar vacaciones aprobadas traslapadas del empleado;

if (¿Existe traslape aprobado?) then (Sí)
:Cancelar aprobación;
:Mostrar error "La solicitud se traslapa con vacaciones aprobadas";
stop
else (No)
endif

:Calcular días disponibles actuales sin duplicar la solicitud actual;

if (¿Tiene días suficientes?) then (Sí)
else (No)
:Cancelar aprobación;
:Mostrar error "El empleado no tiene días de vacaciones suficientes";
stop
endif

:Actualizar solicitud con status = APPROVED;
:Actualizar used_days recalculado;
:Confirmar transacción;
:Guardar log de aprobación;
:Mostrar mensaje "Solicitud aprobada correctamente";

|Usuario|
:Continuar revisando solicitudes;
stop

@enduml