@startuml
title US29 - Consultar solicitudes de vacaciones pendientes y revisadas

|Usuario|
start
:Entrar al módulo de solicitudes de vacaciones;

|Sistema|
:Aplicar rate limit;
:Validar token de sesión;

if (¿Token válido?) then (Sí)
else (No)
:Mostrar error de autenticación;
stop
endif

:Validar rol Coordinador;

if (¿Rol permitido?) then (Sí)
else (No)
:Mostrar error "Rol no permitido";
stop
endif

:Validar privilegio manageEmployees;

if (¿Tiene privilegio?) then (Sí)
else (No)
:Mostrar error "Permisos insuficientes";
stop
endif

|Usuario|
if (¿Quiere consultar pendientes o revisadas?) then (Pendientes)
:Entrar a vista de solicitudes pendientes;

|Sistema|
:Validar query params con schema;
if (¿Query válida?) then (Sí)
else (No)
:Mostrar error de validación;
stop
endif

:Buscar empleado autenticado con rol y casa hogar;

if (¿Coordinador válido?) then (Sí)
else (No)
:Mostrar error de autenticación o permisos;
stop
endif

:Construir filtros por casa hogar, búsqueda, fechas y estado pendiente;
:Consultar solicitudes pendientes de empleados de la misma casa hogar;
:Aplicar paginación;
:Mapear solicitudes para la tabla;
:Devolver solicitudes pendientes y paginación;

|Usuario|
:Visualizar tabla de solicitudes pendientes;
:Puede consultar la información mostrada de cada solicitud;
stop

else (Revisadas)
:Entrar a vista de solicitudes revisadas;

|Sistema|
:Validar query params con schema;
if (¿Query válida?) then (Sí)
else (No)
:Mostrar error de validación;
stop
endif

:Buscar empleado autenticado con rol y casa hogar;

if (¿Coordinador válido?) then (Sí)
else (No)
:Mostrar error de autenticación o permisos;
stop
endif

:Construir filtros por casa hogar, búsqueda, fechas y estado revisado;
:Consultar solicitudes aprobadas y rechazadas de empleados de la misma casa hogar;
:Aplicar paginación;
:Mapear solicitudes para la tabla;
:Devolver solicitudes revisadas y paginación;

|Usuario|
:Visualizar tabla de solicitudes revisadas;
stop
endif

@enduml