@startuml HU82 - Modificar evento personal

actor Navegador
boundary "event.route" as routes
boundary "React (calendarModal.jsx)" as ReactView
control "update.controller" as controller
control "update.service" as event.service
entity "event.model" as event.model
database PostgreSQL

autonumber

Navegador -> ReactView : Seleccionar evento personal existente
activate ReactView

ReactView -> routes : GET /event/getAllTypes
deactivate ReactView
activate routes

routes -> controller : getAllEventTypes(request, response)
deactivate routes
activate controller

controller ->> event.service : getAllEventTypes()
activate event.service
event.service ->> event.model : getAllEventTypes()
activate event.model
event.model ->> PostgreSQL : prisma.event_type.findMany()
activate PostgreSQL
PostgreSQL -->> event.model : eventTypes[]
deactivate PostgreSQL
event.model -->> event.service : eventTypes[]
deactivate event.model
event.service -->> controller : eventTypes[]
deactivate event.service

controller -->> routes : response.status(200).send({ eventTypes })
deactivate controller
activate routes
routes -->> ReactView : send({ eventTypes })
deactivate routes
activate ReactView

ReactView -> routes : GET /event/personal/employees
deactivate ReactView
activate routes

routes -> controller : getEmployeesForSelector(request, response)
deactivate routes
activate controller

controller ->> event.service : getEmployeesForSelector(houseId, search)
activate event.service
event.service ->> event.model : getEmployeesForSelector(houseId, search)
activate event.model
event.model ->> PostgreSQL : SELECT employee_id, name, surname, picture\nFROM employee\nWHERE house_id = houseId\nAND is_active = true
activate PostgreSQL
PostgreSQL -->> event.model : employees[]
deactivate PostgreSQL
event.model -->> event.service : employees[]
deactivate event.model
event.service -->> controller : employees[]
deactivate event.service

controller -->> routes : response.status(200).send({ employees })
deactivate controller
activate routes
routes -->> ReactView : send({ employees })
deactivate routes
activate ReactView

ReactView -> Navegador : Mostrar modal con datos actuales del evento

Navegador -> ReactView : Modificar datos:\n(name, eventType, date, start, end, employee)

alt all_day?
    ReactView -> ReactView : Ocultar selectores de hora
else No
    ReactView -> ReactView : Mostrar selectores de hora
    Navegador -> ReactView : Modificar start y end
end

alt Modificar descripción
    Navegador -> ReactView : Ingresa nueva description
else No
    ReactView -> ReactView : Mantener description actual
end

ReactView -> ReactView : Validar campos obligatorios

alt Campos incompletos
    ReactView -> Navegador : Mostrar error (422)
    deactivate ReactView

else Campos completos

    Navegador -> routes : PUT /event/personal/:eventId
    deactivate ReactView
    activate routes

    routes -> controller : updatePersonalEvent(request, response)
    deactivate routes
    activate controller

    controller ->> event.service : updatePersonalEvent(eventId, user, payload, clientIp)
    activate event.service

    event.service -> event.service : resolveEmployeeIds(user, employeeIdsInput, forceOverlap)

    alt user.role != "Coordinador" AND forceOverlap == true
        event.service -->> controller : { code: NOT_ACCESS }
        controller -->> routes : response.status(403)
        activate routes
        routes -->> ReactView : send(403)
        deactivate routes
        activate ReactView
        ReactView -> Navegador : Mostrar error "Sin permisos"
        deactivate ReactView

    else user.role == "Coordinador" AND employeeIds vacío
        event.service -->> controller : { code: EMPLOYEE.NOT_PROVIDED }
        controller -->> routes : response.status(400)
        activate routes
        routes -->> ReactView : send(400)
        deactivate routes
        activate ReactView
        ReactView -> Navegador : Mostrar error "Selecciona al menos un empleado"
        deactivate ReactView

    else employeeIds resueltos

        event.service ->> event.model : findPersonalEventById(eventId, houseId)
        activate event.model
        event.model ->> PostgreSQL : prisma.personal_event.findFirst()\nwhere personal_event_id = eventId\nAND is_deleted = false\nAND employee.house_id = houseId
        activate PostgreSQL
        PostgreSQL -->> event.model : personalEvent | null
        deactivate PostgreSQL
        event.model -->> event.service : personalEvent | null
        deactivate event.model

        alt Evento no encontrado
            event.service -->> controller : { code: NOT_FOUND }
            controller -->> routes : response.status(404)
            activate routes
            routes -->> ReactView : send(404)
            deactivate routes
            activate ReactView
            ReactView -> Navegador : Mostrar error "Evento no encontrado"
            deactivate ReactView

        else Evento encontrado

            alt user.role != "Coordinador"
                event.service -> event.service : ¿user.id en employee_personal_event?
                alt No asignado al evento
                    event.service -->> controller : { code: NOT_ACCESS }
                    controller -->> routes : response.status(403)
                    activate routes
                    routes -->> ReactView : send(403)
                    deactivate routes
                    activate ReactView
                    ReactView -> Navegador : Mostrar error "Sin permisos"
                    deactivate ReactView
                end
            end

            event.service ->> event.model : getEmployeesInHouse(employeeIds, houseId)
            activate event.model
            event.model ->> PostgreSQL : prisma.employee.findMany()\nwhere employee_id IN employeeIds\nAND house_id = houseId
            activate PostgreSQL
            PostgreSQL -->> event.model : foundEmployees[]
            deactivate PostgreSQL
            event.model -->> event.service : foundEmployees[]
            deactivate event.model

            alt foundEmployees.length != employeeIds.length
                event.service -->> controller : { code: EMPLOYEE.NOT_FOUND }
                controller -->> routes : response.status(404)
                activate routes
                routes -->> ReactView : send(404)
                deactivate routes
                activate ReactView
                ReactView -> Navegador : Mostrar error "Empleado no válido para esta casa"
                deactivate ReactView
            else Empleados válidos

                event.service ->> event.model : findOverlappingEmployees({ employeeIds, date, start, end, endDate, excludeEventId })
                activate event.model
                event.model ->> PostgreSQL : prisma.employee_personal_event.findMany()\nwhere personal_event_id != eventId\nAND date = date AND start < end AND end > start
                activate PostgreSQL
                PostgreSQL -->> event.model : collisions[]
                deactivate PostgreSQL
                event.model -->> event.service : collisions[]
                deactivate event.model

                alt Existe empalme AND (user.role != "Coordinador" OR !forceOverlap)
                    event.service -->> controller : { code: OVERLAP, data: { overlappedEmployees } }
                    controller -->> routes : response.status(409).send("Conflicto")
                    activate routes
                    routes -->> ReactView : send("Conflicto")
                    deactivate routes
                    activate ReactView

                    alt user.role == "Coordinador"
                        ReactView -> Navegador : Mostrar alerta de empalme con opción de continuar
                        deactivate ReactView

                        alt No desea continuar
                            Navegador -> ReactView : Selecciona "No"
                            activate ReactView
                            ReactView -> Navegador : Regresar a edición
                            deactivate ReactView
                        else Desea continuar
                            Navegador -> ReactView : Selecciona "Sí"
                            activate ReactView
                            ReactView -> routes : PUT /event/personal/:eventId { forceOverlap: true }
                            deactivate ReactView
                            activate routes
                            routes -> controller : updatePersonalEvent(request, response)
                            deactivate routes
                        end

                    else No es Coordinador
                        ReactView -> Navegador : Mostrar alerta "Existe empalme, seleccione otro horario"
                        ReactView -> Navegador : Regresar a edición
                        deactivate ReactView
                    end

                else No hay empalme OR forceOverlap == true

                    event.service ->> event.model : updatePersonalEvent(eventId, data)
                    activate event.model
                    event.model ->> PostgreSQL : prisma.personal_event.update()
                    activate PostgreSQL
                    PostgreSQL -->> event.model : personalEventUpdated
                    deactivate PostgreSQL
                    event.model ->> PostgreSQL : prisma.employee_personal_event.deleteMany()
                    activate PostgreSQL
                    PostgreSQL -->> event.model : oldRelationsDeleted
                    deactivate PostgreSQL
                    event.model ->> PostgreSQL : prisma.employee_personal_event.createMany()
                    activate PostgreSQL
                    PostgreSQL -->> event.model : newRelationsCreated
                    deactivate PostgreSQL
                    event.model -->> event.service : personalEvent
                    deactivate event.model

                    event.service ->> event.model : createLog(userId, action, clientIp, eventId)
                    activate event.model
                    event.model ->> PostgreSQL : prisma.log.create()
                    activate PostgreSQL
                    PostgreSQL -->> event.model : log
                    deactivate PostgreSQL
                    event.model -->> event.service : success
                    deactivate event.model

                    event.service -->> controller : { code: UPDATED, data: { personalEvent } }
                    deactivate event.service
                    controller -->> routes : response.status(200).send("Actualizado")
                    deactivate controller
                    activate routes
                    routes -->> ReactView : send("Actualizado")
                    deactivate routes
                    activate ReactView
                    ReactView -> Navegador : Actualizar calendario y cerrar modal
                    deactivate ReactView
                end
            end
        end
    end
end

@enduml
