@startuml
title US35 - Coordinador rechaza solicitud de vacaciones

actor "Coordinador" as Usuario
boundary "Frontend" as Frontend
control "vacation.route.js" as Router
control "auth/rbac/validate middleware" as Middleware
control "update.controller.js" as Controller
control "update.service.js" as Service
database "vacation/get.model.js" as VacationGetModel
database "employee/get.model.js" as EmployeeGetModel
database "vacation/update.model.js" as VacationUpdateModel
database "log.model.js" as LogModel
database "Base de datos" as DB

autonumber

Usuario -> Frontend : Selecciona solicitud pendiente
Usuario -> Frontend : Confirma rechazo
Usuario -> Frontend : Opcionalmente escribe feedback

Frontend -> Router : PATCH /vacation/request/:vacationRequestId/reject\nAuthorization: Bearer token\n{ feedback? }

Router -> Middleware : apiLimiter
Router -> Middleware : verifyToken
Router -> Middleware : requireRole(Coordinador)
Router -> Middleware : requirePrivileges(manageEmployees)
Router -> Middleware : validate(rejectVacationRequestSchema, "all")

alt Middleware rechaza request
Middleware --> Frontend : 400/401/403
else Request HTTP válida
Router -> Controller : rejectVacationRequest(req, res)

Controller -> Service : rejectVacationRequest({\nactorEmployeeId,\nvacationRequestId,\nfeedback,\nipAddress\n})

Service -> Service : Validar contrato interno con schema de caso de uso

alt Entrada interna inválida
Service --> Controller : VALIDATION_ERROR
Controller --> Frontend : 400 Datos inválidos
else Entrada interna válida
Service -> EmployeeGetModel : findByIdWithRoleAndHouse(actorEmployeeId)
EmployeeGetModel -> DB : SELECT employee + role + house
DB --> EmployeeGetModel : Actor coordinador
EmployeeGetModel --> Service : Actor

alt Actor no existe
Service --> Controller : USER_NOT_AUTHENTICATED
Controller --> Frontend : 401 Usuario no autenticado
else Actor no es Coordinador
Service --> Controller : INSUFFICIENT_PERMISSIONS
Controller --> Frontend : 403 Permisos insuficientes
else Actor válido
Service -> VacationGetModel : getVacationRequestById(vacationRequestId)
VacationGetModel -> DB : SELECT vacations_request
DB --> VacationGetModel : Solicitud
VacationGetModel --> Service : Solicitud

alt Solicitud no existe
Service --> Controller : VACATION_REQUEST_NOT_FOUND
Controller --> Frontend : 404 Solicitud no encontrada
else Solicitud no pendiente
Service --> Controller : VACATION_REQUEST_ALREADY_REVIEWED
Controller --> Frontend : 406 Solicitud ya revisada
else Solicitud pendiente
Service -> EmployeeGetModel : findByIdWithRoleAndHouse(targetEmployeeId)
EmployeeGetModel -> DB : SELECT employee + role + house
DB --> EmployeeGetModel : Empleado dueño
EmployeeGetModel --> Service : Empleado

alt Empleado no existe
Service --> Controller : EMPLOYEE_NOT_FOUND
Controller --> Frontend : 404 Empleado no encontrado
else Empleado fuera de alcance
Service --> Controller : EMPLOYEE_OUT_OF_SCOPE
Controller --> Frontend : 403 No puede acceder a este recurso
else Actor autorizado
Service -> VacationUpdateModel : rejectVacationRequestAtomically({\nvacationRequestId,\nemployeeId,\nactorHouseId,\nfeedback\n})

VacationUpdateModel -> DB : BEGIN TRANSACTION
VacationUpdateModel -> DB : SELECT employee FOR UPDATE
VacationUpdateModel -> DB : Releer solicitud
VacationUpdateModel -> DB : Validar que existe
VacationUpdateModel -> DB : Validar que pertenece al empleado esperado
VacationUpdateModel -> DB : Releer empleado
VacationUpdateModel -> DB : Validar misma casa y que no sea Administrador
VacationUpdateModel -> DB : Validar que sigue pendiente
VacationUpdateModel -> DB : UPDATE status = REJECTED,\nfeedback = feedback/null
DB --> VacationUpdateModel : Solicitud rechazada
VacationUpdateModel -> DB : COMMIT
VacationUpdateModel --> Service : Solicitud rechazada

alt Transacción detecta solicitud ya revisada o fuera de alcance
Service --> Controller : ALREADY_REVIEWED / OUT_OF_SCOPE
Controller --> Frontend : 406/403 Error de rechazo
else Rechazo exitoso
Service -> LogModel : createLog(actorEmployeeId,\nVACATION_REJECTED_SUCCESS,\nipAddress,\ntargetEmployeeId)
LogModel -> DB : INSERT logs
DB --> LogModel : Log creado

Service --> Controller : VACATION_REJECTED
Controller --> Frontend : 200 Solicitud rechazada correctamente
Frontend --> Usuario : Mostrar confirmación
end
end
end
end
end
end

@enduml