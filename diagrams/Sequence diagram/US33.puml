@startuml HU33 - Usuario remueve vacaciones

actor navegador
boundary vacation.routes
control vacation.delete.controller
control vacation.delete.service
entity employee.get.model
entity vacation.get.model
entity vacation.delete.model
entity log.model
database PostgreSQL

autonumber

navegador -> vacation.routes : DELETE /vacation/request/:vacationRequestId
activate navegador
activate vacation.routes
vacation.routes -> vacation.delete.controller : deleteVacationRequest(req, res)
deactivate vacation.routes
activate vacation.delete.controller
vacation.delete.controller -> vacation.delete.controller : ipAddress = getClientIp(req)
vacation.delete.controller ->> vacation.delete.service : deleteVacationRequest(actorEmployeeId, vacationRequestId, ipAddress)
activate vacation.delete.service

vacation.delete.service -> vacation.delete.service : deleteVacationRequestInputSchema.safeParse({\n\tactorEmployeeId,\n\tvacationRequestId,\n\tipAddress\n})
alt datos inválidos
vacation.delete.service -->> vacation.delete.controller : VACATION.VALIDATION_ERROR
vacation.delete.controller -> navegador : 422 Unprocessable Entity {\n\tsuccess: false,\n\tmessage: "Datos inválidos"\n}
end

vacation.delete.service ->> employee.get.model : findByIdWithRoleAndHouse(actorEmployeeId)
activate employee.get.model
employee.get.model ->> PostgreSQL : prisma.employee.findUnique({\n\twhere: {\n\t\temployee_id: actorEmployeeId\n\t},\n\tinclude: {\n\t\trole: true\n\t}\n})
activate PostgreSQL
PostgreSQL -->> employee.get.model : result
deactivate PostgreSQL
employee.get.model -->> vacation.delete.service : actorEmployee
deactivate employee.get.model

alt actorEmployee no existe
vacation.delete.service -->> vacation.delete.controller : USER.NOT_ACCESS
vacation.delete.controller -> navegador : 401 Unauthorized {\n\tsuccess: false,\n\tmessage: "Usuario no autenticado"\n}
end

vacation.delete.service ->> vacation.get.model : getVacationRequestById(vacationRequestId)
activate vacation.get.model
vacation.get.model ->> PostgreSQL : prisma.vacations_request.findUnique({\n\twhere: {\n\t\tvacations_request_id: vacationRequestId\n\t},\n\tinclude: {\n\t\temployee: true\n\t}\n})
activate PostgreSQL
PostgreSQL -->> vacation.get.model : result
deactivate PostgreSQL
vacation.get.model -->> vacation.delete.service : vacationRequest
deactivate vacation.get.model

alt vacationRequest no existe
vacation.delete.service -->> vacation.delete.controller : VACATION.REQUEST_NOT_FOUND
vacation.delete.controller -> navegador : 404 Not Found {\n\tsuccess: false,\n\tmessage: "Solicitud de vacaciones no encontrada"\n}
end

vacation.delete.service -> vacation.delete.service : targetEmployeeId = vacationRequest.employee_id
vacation.delete.service -> vacation.delete.service : isSelfDeletion = actorEmployeeId == targetEmployeeId
vacation.delete.service -> vacation.delete.service : isCoordinatorDeletion = actorRole == Coordinador && !isSelfDeletion

vacation.delete.service ->> employee.get.model : findByIdWithRoleAndHouse(targetEmployeeId)
activate employee.get.model
employee.get.model ->> PostgreSQL : prisma.employee.findUnique({\n\twhere: {\n\t\temployee_id: targetEmployeeId\n\t},\n\tinclude: {\n\t\trole: true\n\t}\n})
activate PostgreSQL
PostgreSQL -->> employee.get.model : result
deactivate PostgreSQL
employee.get.model -->> vacation.delete.service : targetEmployee
deactivate employee.get.model

alt targetEmployee no existe
vacation.delete.service -->> vacation.delete.controller : EMPLOYEE.NOT_FOUND
vacation.delete.controller -> navegador : 404 Not Found {\n\tsuccess: false,\n\tmessage: "Empleado no encontrado"\n}
end

alt no es dueño ni Coordinador
vacation.delete.service -->> vacation.delete.controller : VACATION.INSUFFICIENT_PERMISSIONS
vacation.delete.controller -> navegador : 403 Forbidden {\n\tsuccess: false,\n\tmessage: "No tienes permisos para remover vacaciones"\n}
end

alt Coordinador intenta remover a empleado fuera de su casa o Admin
vacation.delete.service -->> vacation.delete.controller : VACATION.EMPLOYEE_OUT_OF_SCOPE
vacation.delete.controller -> navegador : 403 Forbidden {\n\tsuccess: false,\n\tmessage: "Permisos insuficientes"\n}
end

rnote over vacation.delete.service
Se valida si la vacación todavía se puede remover.

Si la vacación ya inició, cuenta como pasada.
Las vacaciones aprobadas no se pueden remover
cuando ya iniciaron o terminaron.
endrnote
vacation.delete.service -> vacation.delete.service : currentDate = getTodayMexicoDate()
vacation.delete.service -> vacation.delete.service : canRemoveVacationRequest(vacationRequest, currentDate)

alt la solicitud no se puede remover
vacation.delete.service -->> vacation.delete.controller : VACATION.REQUEST_NOT_MODIFIABLE
vacation.delete.controller -> navegador : 406 Not Acceptable {\n\tsuccess: false,\n\tmessage: "No se pueden remover vacaciones aprobadas que ya iniciaron o terminaron"\n}
end

vacation.delete.service ->> vacation.delete.model : deleteVacationRequestAtomically({\n\tvacationRequestId,\n\ttargetEmployeeId,\n\tactorHouseId,\n\tcurrentDate,\n\tisSelfDeletion\n})
activate vacation.delete.model

rnote over vacation.delete.model
La eliminación se hace dentro de una transacción.
Primero se bloquea al empleado para evitar que
dos solicitudes eliminen la misma vacación al mismo tiempo.
endrnote

vacation.delete.model ->> PostgreSQL : transaction.$queryRaw(SELECT employee_id\nFROM employee\nWHERE employee_id = employeeId\nFOR UPDATE)
activate PostgreSQL
PostgreSQL -->> vacation.delete.model : result
deactivate PostgreSQL

vacation.delete.model ->> PostgreSQL : transaction.vacations_request.findUnique({\n\twhere: {\n\t\tvacations_request_id: vacationRequestId\n\t}\n})
activate PostgreSQL
PostgreSQL -->> vacation.delete.model : vacationRequest
deactivate PostgreSQL

alt vacationRequest no existe dentro de la transacción
vacation.delete.model -->> vacation.delete.service : VACATION.REQUEST_NOT_FOUND
vacation.delete.service -->> vacation.delete.controller : VACATION.REQUEST_NOT_FOUND
vacation.delete.controller -> navegador : 404 Not Found {\n\tsuccess: false,\n\tmessage: "Solicitud de vacaciones no encontrada"\n}
end

alt vacationRequest.employee_id != targetEmployeeId
vacation.delete.model -->> vacation.delete.service : VACATION.EMPLOYEE_OUT_OF_SCOPE
vacation.delete.service -->> vacation.delete.controller : VACATION.EMPLOYEE_OUT_OF_SCOPE
vacation.delete.controller -> navegador : 403 Forbidden {\n\tsuccess: false,\n\tmessage: "Permisos insuficientes"\n}
end

vacation.delete.model ->> PostgreSQL : transaction.employee.findUnique({\n\twhere: {\n\t\temployee_id: targetEmployeeId\n\t},\n\tinclude: {\n\t\trole: true\n\t}\n})
activate PostgreSQL
PostgreSQL -->> vacation.delete.model : targetEmployee
deactivate PostgreSQL

alt targetEmployee no existe dentro de la transacción
vacation.delete.model -->> vacation.delete.service : EMPLOYEE.NOT_FOUND
vacation.delete.service -->> vacation.delete.controller : EMPLOYEE.NOT_FOUND
vacation.delete.controller -> navegador : 404 Not Found {\n\tsuccess: false,\n\tmessage: "Empleado no encontrado"\n}
end

alt se detecta alcance inválido dentro de la transacción
vacation.delete.model -->> vacation.delete.service : VACATION.EMPLOYEE_OUT_OF_SCOPE
vacation.delete.service -->> vacation.delete.controller : VACATION.EMPLOYEE_OUT_OF_SCOPE
vacation.delete.controller -> navegador : 403 Forbidden {\n\tsuccess: false,\n\tmessage: "Permisos insuficientes"\n}
end

alt la solicitud dejó de poder removerse dentro de la transacción
vacation.delete.model -->> vacation.delete.service : VACATION.REQUEST_NOT_MODIFIABLE
vacation.delete.service -->> vacation.delete.controller : VACATION.REQUEST_NOT_MODIFIABLE
vacation.delete.controller -> navegador : 406 Not Acceptable {\n\tsuccess: false,\n\tmessage: "No se pueden remover vacaciones aprobadas que ya iniciaron o terminaron"\n}
end

vacation.delete.model ->> PostgreSQL : transaction.vacations_request.delete({\n\twhere: {\n\t\tvacations_request_id: vacationRequestId\n\t}\n})
activate PostgreSQL
PostgreSQL -->> vacation.delete.model : deletedVacationRequest
deactivate PostgreSQL
vacation.delete.model -->> vacation.delete.service : vacationRequest
deactivate vacation.delete.model

vacation.delete.service ->> log.model : createLog(actorEmployeeId, VACATION_DELETED_SUCCESS, ipAddress, targetEmployeeId)
activate log.model
log.model ->> PostgreSQL : prisma.logs.create({\n\tdata: {\n\t\tlog_id: randomUUID(),\n\t\temployee_id: actorEmployeeId,\n\t\tmoment: new Date(),\n\t\taction_id: actionId,\n\t\taffected: targetEmployeeId,\n\t\tip_address: hashIp(ipAddress)\n\t}\n})
activate PostgreSQL
PostgreSQL -->> log.model : result
deactivate PostgreSQL
log.model -->> vacation.delete.service : result
deactivate log.model

vacation.delete.service -->> vacation.delete.controller : VACATION.DELETED
deactivate vacation.delete.service
vacation.delete.controller -> navegador : 200 OK {\n\tsuccess: true,\n\tmessage: "Vacaciones removidas correctamente",\n\tdata: {\n\t\tvacationRequest: {}\n\t}\n}
deactivate vacation.delete.controller
deactivate navegador

@enduml
