@startuml HU32 - Coordinador remueve vacaciones de un empleado

actor Navegador
boundary "vacation.routes" as routes
boundary "React (calendario.jsx)" as ReactView
control "delete.controller" as controller
control "delete.service" as vacation.service
entity "employee/get.model" as employeeGet.model
entity "vacation/get.model" as vacationGet.model
entity "vacation/delete.model" as vacationDelete.model
entity "log.model" as log.model
database PostgreSQL

autonumber

Navegador -> ReactView : Selecciona vacaciones y da clic en Eliminar
activate ReactView

ReactView -> Navegador : Muestra modal de confirmación

alt Cancela eliminación
Navegador -> ReactView : Selecciona Cancelar
ReactView -> Navegador : Cierra modal sin cambios
deactivate ReactView

else Confirma eliminación
Navegador -> ReactView : Selecciona Eliminar

ReactView -> routes : DELETE /vacation/request/:vacationRequestId
deactivate ReactView
activate routes

routes -> controller : deleteVacationRequest(request, response)
deactivate routes
activate controller

controller -> vacation.service : deleteVacationRequest(actorEmployeeId,\nvacationRequestId, ipAddress)
activate vacation.service

vacation.service -> vacation.service : Validar datos de entrada

alt Datos inválidos
vacation.service -->> controller : { code: VALIDATION_ERROR }
deactivate vacation.service
controller -->> routes : response.status(422).send(error)
deactivate controller
activate routes
routes -->> ReactView : send(422)
deactivate routes
activate ReactView
ReactView -> Navegador : Mostrar error de validación
deactivate ReactView

else Datos válidos
vacation.service -> employeeGet.model : findByIdWithRoleAndHouse(actorEmployeeId)
activate employeeGet.model
employeeGet.model -> PostgreSQL : SELECT employee + role + house
activate PostgreSQL
PostgreSQL -->> employeeGet.model : actor | null
deactivate PostgreSQL
employeeGet.model -->> vacation.service : actor | null
deactivate employeeGet.model

alt Actor no existe o no tiene permisos
vacation.service -->> controller : { code: USER_NOT_AUTHENTICATED / INSUFFICIENT_PERMISSIONS }
deactivate vacation.service
controller -->> routes : response.status(401/403).send(error)
deactivate controller
activate routes
routes -->> ReactView : send(401/403)
deactivate routes
activate ReactView
ReactView -> Navegador : Mostrar error de permisos
deactivate ReactView

else Actor autorizado
vacation.service -> vacationGet.model : getVacationRequestById(vacationRequestId)
activate vacationGet.model
vacationGet.model -> PostgreSQL : SELECT vacations_request
activate PostgreSQL
PostgreSQL -->> vacationGet.model : vacationRequest | null
deactivate PostgreSQL
vacationGet.model -->> vacation.service : vacationRequest | null
deactivate vacationGet.model

alt Solicitud no existe
vacation.service -->> controller : { code: REQUEST_NOT_FOUND }
deactivate vacation.service
controller -->> routes : response.status(404).send(error)
deactivate controller
activate routes
routes -->> ReactView : send(404)
deactivate routes
activate ReactView
ReactView -> Navegador : Mostrar solicitud no encontrada
deactivate ReactView

else Solicitud existe
vacation.service -> employeeGet.model : findByIdWithRoleAndHouse(targetEmployeeId)
activate employeeGet.model
employeeGet.model -> PostgreSQL : SELECT employee + role + house
activate PostgreSQL
PostgreSQL -->> employeeGet.model : targetEmployee | null
deactivate PostgreSQL
employeeGet.model -->> vacation.service : targetEmployee | null
deactivate employeeGet.model

alt Empleado no existe o está fuera de alcance
vacation.service -->> controller : { code: EMPLOYEE_NOT_FOUND / EMPLOYEE_OUT_OF_SCOPE }
deactivate vacation.service
controller -->> routes : response.status(403/404).send(error)
deactivate controller
activate routes
routes -->> ReactView : send(403/404)
deactivate routes
activate ReactView
ReactView -> Navegador : Mostrar error
deactivate ReactView

else Solicitud no removible
vacation.service -> vacation.service : canRemoveVacationRequest(vacationRequest)

vacation.service -->> controller : { code: REQUEST_NOT_MODIFIABLE }
deactivate vacation.service
controller -->> routes : response.status(406).send(error)
deactivate controller
activate routes
routes -->> ReactView : send(406)
deactivate routes
activate ReactView
ReactView -> Navegador : Mostrar que no se puede eliminar
deactivate ReactView

else Solicitud removible
vacation.service -> vacationDelete.model : deleteVacationRequestAtomically(vacationRequestId,\ntargetEmployeeId, actorHouseId)
activate vacationDelete.model

vacationDelete.model -> PostgreSQL : BEGIN TRANSACTION
activate PostgreSQL
PostgreSQL -->> vacationDelete.model : transacción iniciada

vacationDelete.model -> PostgreSQL : SELECT employee FOR UPDATE
PostgreSQL -->> vacationDelete.model : empleado bloqueado

vacationDelete.model -> PostgreSQL : SELECT vacations_request
PostgreSQL -->> vacationDelete.model : vacationRequest actual

vacationDelete.model -> PostgreSQL : SELECT employee + role
PostgreSQL -->> vacationDelete.model : empleado actual

vacationDelete.model -> vacationDelete.model : Validar existencia, pertenencia,\nalcance y regla de eliminación

alt Transacción detecta conflicto
vacationDelete.model -> PostgreSQL : ROLLBACK
PostgreSQL -->> vacationDelete.model : transacción revertida
deactivate PostgreSQL

vacationDelete.model -->> vacation.service : { success: false, code }
deactivate vacationDelete.model

vacation.service -->> controller : { code }
deactivate vacation.service
controller -->> routes : response.status(403/404/406).send(error)
deactivate controller
activate routes
routes -->> ReactView : send(error)
deactivate routes
activate ReactView
ReactView -> Navegador : Mostrar error de eliminación
deactivate ReactView

else Eliminación válida
vacationDelete.model -> PostgreSQL : DELETE vacations_request
PostgreSQL -->> vacationDelete.model : vacationRequest eliminada

vacationDelete.model -> PostgreSQL : COMMIT
PostgreSQL -->> vacationDelete.model : transacción confirmada
deactivate PostgreSQL

vacationDelete.model -->> vacation.service : vacationRequest eliminada
deactivate vacationDelete.model

vacation.service -> log.model : createLog(actorEmployeeId,\nVACATION_DELETED_SUCCESS, ipAddress, targetEmployeeId)
activate log.model
log.model -> PostgreSQL : INSERT log
activate PostgreSQL
PostgreSQL -->> log.model : log creado
deactivate PostgreSQL
log.model -->> vacation.service : success
deactivate log.model

vacation.service -->> controller : { code: VACATION_DELETED, data }
deactivate vacation.service
controller -->> routes : response.status(200).send(data)
deactivate controller
activate routes
routes -->> ReactView : send(200)
deactivate routes
activate ReactView
ReactView -> Navegador : Actualizar calendario y mostrar éxito
deactivate ReactView
end
end
end
end
end
end

@enduml