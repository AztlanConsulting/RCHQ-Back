@startuml
title US39 - Consultar las ausencias en el calendario (Sequence Diagram)

actor Coordinador
participant "event.route.js\nrouter" as Router
participant "Middlewares\nAuth, ABAC" as Middlewares
participant "get.controller.js\ngetHouseCalendarRecords..." as Controller
participant "get.service.js\ngetHouseCalendarRecords..." as Service
participant "utils/dates.js" as DatesUtil
participant "absence/get.model.js" as AbsModel
participant "event/get.model.js" as EventModel
participant "vacation/get.model.js" as VacModel
participant "utils/mappers\nabsence.map.js / event.map.js" as Mappers
database "BD (Prisma)" as BD

Coordinador -> Router : GET /house/range/:startDate/:endDate
Router -> Middlewares : verifyToken, resolveRequesterHouse, authorize
Middlewares --> Router : next()

Router -> Controller : getHouseCalendarRecordsInRange(req, res)
activate Controller

Controller ->> Service : await getHouseCalendarRecordsInRange(houseId, startDate, endDate)
activate Service

Service -> DatesUtil : stringToDate(rawStartDate)

Service ->> AbsModel : await getHouseCalendarAbsenceInRange(requesterId, houseId, startDate, endDate)
AbsModel ->> BD : prisma.absence.findMany(...)
BD -->> AbsModel : absences
AbsModel -->> Service : absences

Service ->> EventModel : Promise.all([getHouseEvents, getGlobalEvents, getHousePersonalEvents])
EventModel ->> BD : Múltiples consultas a events
BD -->> EventModel : houseEvents, globalEvents, personalEvents
EventModel -->> Service : eventos para calendario y freeDays

Service ->> VacModel : await getHouseCalendarVacationsInRange(...)
VacModel ->> BD : prisma.vacations_request.findMany(...)
BD -->> VacModel : vacations
VacModel -->> Service : vacations

Service -> Service : Filtra freeDays (eventos globales/casa)

loop por cada ausencia en la casa
    Service -> DatesUtil : calculateUsedDays(absence.employee.employee_workday, start, end, freeDays)
    Service -> Mappers : mapHouseAbsenceCalendarEvent(absence, usedDays)
end

Service --> Controller : { code: RESPONSES.EVENTS.FOUND, data: { events } }
deactivate Service

Controller --> Coordinador : res.status(200).json(data)
deactivate Controller

@enduml
