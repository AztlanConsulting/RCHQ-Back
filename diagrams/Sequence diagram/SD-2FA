front:
@startuml
title Activar / Desactivar 2FA — Frontend (React + Atomic Design)

actor Usuario

boundary "Page\n(MoreOptions)" as Page
boundary "Organism\n(TwoFactorAuth)" as Organism
boundary "Molecule\n(TwoFactorCode)" as Molecule
boundary "Atom\n(TextField / Button / Alert)" as Atom
control "Service\n(AuthService)" as Service
control "back/api" as API

== Activar 2FA ==

Usuario -> Page : Click "Activar 2FA"
Page -> Organism : show2FAModal = true\nRenderiza TwoFactorAuth

Organism -> Service : activateTwoFactorAuthService()
Service --> API: fetch POST /users/2fa/setup\nAuthorization: Bearer token

Service --> Organism : { qrImage, otpauthUrl }
Organism -> Atom : Renderiza <img src=qrImage />\ny código manual

Usuario -> Organism : Presiona "Continuar"
Organism -> Molecule : Renderiza TwoFactorCode\n(step = "code")
Molecule -> Atom : Renderiza TextField + Button

Usuario -> Atom : Ingresa código 6 dígitos
Atom -> Molecule : setValue(code)
Molecule -> Organism : onSubmit()

Organism -> Service : verify2FAService(code)
Service --> API: fetch POST /users/2fa/verify\nAuthorization: Bearer token\nbody: { token: code }

alt Código válido
    Service --> Organism : { nextStep: "2FA_SETUP_COMPLETE" }
    Organism -> Page : onClose()
    Page -> Atom : <Alert type="success" />\n"2FA activado correctamente"
    Page -> Page : setIs2FAActive(true)\nBotón cambia a "Desactivar 2FA"
else Código inválido
    Service --> Organism : Error
    Organism -> Atom : <Alert type="error" />\n"Código 2FA inválido"
end

== Desactivar 2FA ==

Usuario -> Page : Click "Desactivar 2FA"
Page -> Page : showDisableModal = true

Page -> Atom : Renderiza TextField (password)\n+ Button "Confirmar"

Usuario -> Atom : Ingresa contraseña
Atom -> Page : setValue(password)

Usuario -> Page : Click "Confirmar"
Page -> Service : desactivate2FAService(password)
Service --> API: fetch POST /users/2fa/disable\nAuthorization: Bearer token\nbody: { password }

alt Contraseña válida
    Service --> Page : { nextStep: "2FA_DISABLED" }
    Page -> Page : setIs2FAActive(false)\nBotón cambia a "Activar 2FA"
    Page -> Atom : <Alert type="success" />\n"2FA desactivado correctamente"\n(auto-oculta en 4s)
else Contraseña inválida
    Service --> Page : Error "Invalid credentials"
    Page -> Atom : <Alert type="error" />\n"Credenciales inválidas"
end

@enduml


back:
@startuml
title Activar / Desactivar 2FA — Backend (MVC + Service + Prisma)

actor Cliente as "Frontend"
boundary "Router\n(user.routes.js)" as Router
control "Controller\n(user.controller.js)" as Controller
control "Service\n(auth.service.js)" as Service
entity "Model\n(user.model.js)" as Model
entity "Middleware\n(verifyToken)" as Middleware
database "PostgreSQL\n(via Prisma)" as Postgres

== Setup 2FA (Generar QR) ==

Cliente -> Router : POST /users/2fa/setup\nAuthorization: Bearer token
Router -> Middleware : verifyToken(req)
Middleware --> Router : req.user = { id, email, role }
Router -> Controller : setupTwoFactorAuth(req, res)
Controller -> Service : setupTwoFactorAuth(req)

Service -> Model : getEmployeeById(req.body.id)
Model -> Postgres : prisma.employee.findUnique\n(employee_id)
Postgres --> Model : employee
Model --> Service : employee

alt Empleado no encontrado
    Service --> Controller : { status: 404 }
    Controller --> Cliente : { success: false,\nmessage: "Employee not found" }
else 2FA ya activo
    Service --> Controller : { status: 409 }
    Controller --> Cliente : { success: false,\nmessage: "2FA already enabled" }
else OK
    Service -> Service : speakeasy.generateSecret()
    Service -> Model : saveTempTotpSecret(employeeId, secret)
    Model -> Postgres : prisma.employee.update\n(temp_totp_secret,\ntemp_totp_secret_created_at)
    Postgres --> Model : OK
    Service -> Service : QRCode.toDataURL(otpauthUrl)
    Service --> Controller : { status: 200, qrImage, otpauthUrl }
    Controller --> Cliente : { success: true,\ndata: { qrImage, otpauthUrl } }
end

== Verify 2FA (Confirmar código) ==

Cliente -> Router : POST /users/2fa/verify\nAuthorization: Bearer token\nbody: { token: code }
Router -> Middleware : verifyToken(req)
Middleware --> Router : req.user = { id }
Router -> Controller : verifyTwoFactorSetup(req, res)
Controller -> Service : verifyTwoFactorSetup(req)

Service -> Model : getEmployeeById(req.user.id)
Model -> Postgres : prisma.employee.findUnique
Postgres --> Model : employee
Model --> Service : employee

Service -> Service : speakeasy.totp.verify\n(tempTotpSecret, code)

alt Código válido
    Service -> Postgres : prisma.$transaction\n- update totp_secret\n- clear temp_totp_secret\n- is_active_2fa = true
    Postgres --> Service : OK
    Service -> Model : createLog(TWO_FA_SETUP_SUCCESS)
    Model -> Postgres : insert log
    Service --> Controller : { status: 200,\nnextStep: "2FA_SETUP_COMPLETE" }
    Controller --> Cliente : { success: true,\nnextStep: "2FA_SETUP_COMPLETE" }
else Código inválido
    Service -> Model : createLog(TWO_FA_SETUP_FAILED)
    Model -> Postgres : insert log
    Service --> Controller : { status: 400 }
    Controller --> Cliente : { success: false,\nmessage: "Invalid 2FA code" }
end

== Disable 2FA ==

Cliente -> Router : POST /users/2fa/disable\nAuthorization: Bearer token\nbody: { password }
Router -> Middleware : verifyToken(req)
Middleware --> Router : req.user = { id }
Router -> Controller : disableTwoFactorAuth(req, res)
Controller -> Service : disableTwoFactorAuth(req)

Service -> Model : getEmployeeById(req.user.id)
Model -> Postgres : prisma.employee.findUnique
Postgres --> Model : employee
Model --> Service : employee

Service -> Service : verifyPassword(password, employee.pwd)

alt Contraseña válida
    Service -> Postgres : prisma.$transaction\n- totp_secret = null\n- is_active_2fa = false
    Postgres --> Service : OK
    Service -> Model : createLog(TWO_FA_DISABLED)
    Model -> Postgres : insert log
    Service --> Controller : { status: 200,\nnextStep: "2FA_DISABLED" }
    Controller --> Cliente : { success: true,\nnextStep: "2FA_DISABLED" }
else Contraseña inválida
    Service -> Model : createLog(TWO_FA_DISABLE_WRONG_PASSWORD)
    Model -> Postgres : insert log
    Service --> Controller : { status: 401 }
    Controller --> Cliente : { success: false,\nmessage: "Invalid credentials" }
end

@enduml