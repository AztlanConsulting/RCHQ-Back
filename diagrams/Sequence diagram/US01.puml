@startuml
title US - Flujo de Inicio de Sesión (Sequence Diagram)

actor Usuario
participant "auth.route.js\nrouter" as Router
participant "validate.js\nmiddleware" as Validator
participant "auth.controller.js\nloginFunction()" as Controller
participant "auth.service.js\nlogin()" as Service
participant "utils/password.js\nverifyPassword()" as PasswordUtil
participant "auth.model.js\nUser" as Model
participant "log.model.js" as LogModel
database "BD (Prisma)" as BD

Usuario -> Router : POST /login (email, password)
Router -> Validator : validate(loginSchema)
alt Fallo en validación
    Validator --> Router : 400 Bad Request
    Router --> Usuario : 400 (Validation Error)
else Validación exitosa
    Validator --> Router : next()
    Router -> Controller : loginFunction(req, res)
    
    activate Controller
    Controller ->> Service : await login(req)
    activate Service
    
    Service ->> Model : await findEmployeeByEmail(normalizedEmail)
    activate Model
    Model ->> BD : prisma.employee.findFirst({ email })
    BD -->> Model : employee / null
    Model -->> Service : mapEmployee(employee)
    deactivate Model
    
    alt !employee
        Service --> Controller : { status: 401, body: INVALID_CREDENTIALS }
    else !employee.isActive
        Service ->> LogModel : await createLog(employeeId, INACTIVE_ACCESS_DENIED, ip)
        LogModel ->> BD : prisma.logs.create(...)
        BD -->> LogModel : success
        Service --> Controller : { status: 401, body: INVALID_CREDENTIALS }
    else isBlockedUntil(employee.blockedUntil)
        Service --> Controller : { status: 423, body: ACCOUNT_TEMPORARILY_BLOCKED }
    else Usuario y estado válidos
        Service ->> Model : await clearExpiredLoginBlock(employee)
        Service ->> PasswordUtil : await verifyPassword(password, employee.pwd)
        activate PasswordUtil
        PasswordUtil -->> Service : passwordMatches
        deactivate PasswordUtil
        
        alt !passwordMatches
            Service ->> Model : await incrementFailedAttempts(employeeId)
            Model ->> BD : prisma.employee.update(...)
            BD -->> Model : attempts
            Service ->> LogModel : await createLog(employeeId, LOGIN_FAILED, ip)
            
            alt attempts >= MAX_LOGIN_ATTEMPTS
                Service ->> Model : await setBlockedUntil(employeeId, blockedUntil)
                Model ->> BD : prisma.employee.update(...)
                BD -->> Model : success
                Service ->> LogModel : await createLog(employeeId, ACCOUNT_BLOCKED, ip)
                Service --> Controller : { status: 423, body: ACCOUNT_TEMPORARILY_BLOCKED }
            else attempts < MAX_LOGIN_ATTEMPTS
                Service --> Controller : { status: 401, body: INVALID_CREDENTIALS }
            end
            
        else passwordMatches == true
            Service ->> Model : await clearLoginSecurityState(employeeId)
            Model ->> BD : prisma.employee.update(...)
            BD -->> Model : success
            
            alt employee.hasFirstLogin
                Service ->> LogModel : await createLog(..., FIRST_LOGIN_PENDING_PASSWORD_CHANGE, ...)
                Service --> Controller : { status: 200, nextStep: CHANGE_PASSWORD_FIRST_LOGIN, ... }
            else employee.isActiveTwoFactorAuth
                Service --> Controller : { status: 200, isActiveTwoFactorAuth: true, preTwoFactorAuthToken }
            else Flujo Normal
                Service ->> LogModel : await createLog(..., LOGIN_SUCCESS, ...)
                Service --> Controller : { status: 200, data: { token, user } }
            end
        end
    end
    deactivate Service
    
    alt Try sin excepciones
        Controller --> Router : res.status(result.status).json(result.body)
        Router --> Usuario : 200 OK / 401 / 423
    catch Excepción (err)
        Controller --> Router : res.status(500).json(Internal Server Error)
        Router --> Usuario : 500 (Internal Server Error)
    end
    deactivate Controller
end
@enduml
