@startuml
title US 28 - Filtrar las vacaciones en pantalla (Sequence Diagram)

actor Empleado
boundary "CalendarPage.jsx" as Page
control "useCalendarFilters.js" as Hook
boundary "vacation.service.js\n(Frontend)" as FEService
participant "event.route.js\nrouter" as Router
participant "get.controller.js\ngetEventsInRange()" as Controller
participant "get.service.js\ngetEventsInRange()" as Service
participant "vacation/get.model.js" as VacModel
participant "utils/mappers\nevent.map.js" as Mappers
database "BD (Prisma)" as BD

Empleado -> Page : Abre la vista de calendario
Page -> Hook : loadCalendarRange(employeeId, startDate, endDate)
activate Hook

Hook -> FEService : getCalendarEvents(employeeId, startDate, endDate)
activate FEService
FEService -> Router : GET /range/:id/:startDate/:endDate
activate Router

Router -> Controller : getEventsInRange(req, res)
activate Controller
Controller ->> Service : await getEventsInRange(employeeId, startDate, endDate)
activate Service

Service ->> VacModel : await getVacationsInRange(employeeId, startDate, endDate)
VacModel ->> BD : prisma.vacations_request.findMany(...)
BD -->> VacModel : vacations[]
VacModel -->> Service : vacations

loop por cada vacación
    Service -> Mappers : mapHouseVacationCalendarEvent(vacation, usedDays)
end

Service --> Controller : { code: FOUND, data: { events } }
deactivate Service
Controller --> Router : res.status(200).json(events)
deactivate Controller
Router --> FEService : events[]
deactivate Router
FEService --> Hook : vacationEvents[]
deactivate FEService

Hook -> Hook : Guarda allVacations y visibleVacations
Hook --> Page : Renderizar vacaciones en calendario
deactivate Hook

Empleado -> Page : Selecciona filtros en pantalla
Page -> Hook : applyVacationFilters(criteria)
activate Hook

alt Hay criterios seleccionados
    Hook -> Hook : Filtra allVacations por estado,\nrango de fechas o tipo

    alt Existen coincidencias
        Hook --> Page : visibleVacations filtradas
        Page --> Empleado : Muestra solo las vacaciones coincidentes
    else Sin coincidencias
        Hook --> Page : []
        Page --> Empleado : Muestra estado vacío
    end
else Sin filtros
    Hook -> Hook : Restablece visibleVacations = allVacations
    Hook --> Page : Todas las vacaciones
    Page --> Empleado : Muestra el calendario completo
end

deactivate Hook
@enduml
