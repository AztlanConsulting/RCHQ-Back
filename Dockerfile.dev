# ---- deps + prisma (builder) ----
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma

# Full install: prisma CLI is required for `prisma generate` (then pruned).
RUN npm ci

COPY . .

RUN npx prisma generate

# Drop devDependencies; keep generated Prisma client under node_modules/.prisma
RUN npm prune --omit=dev

# ---- runtime ----
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/src ./src
COPY --from=builder /app/package.json ./

RUN mkdir -p uploads

EXPOSE 3000

# Use node directly (nodemon is dev-only and not installed after prune)
CMD ["node", "src/index.js"]
