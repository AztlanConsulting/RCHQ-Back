generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model action {
  action_id   String  @id(map: "action_pk") @db.Char(8)
  description String  @db.VarChar(120)
  important   Boolean
  logs        logs[]
}

model documents {
  document_id                         String               @id(map: "documents_pk") @db.Uuid
  cv                                  String?              @db.VarChar(100)
  birth_certificate                   String?              @db.VarChar(100)
  tax_status_certificate              String?              @db.VarChar(100)
  address_certificate                 String?              @db.VarChar(100)
  nss                                 String?              @db.VarChar(100)
  professional_id                     String?              @db.VarChar(100)
  education_certificate               String?              @db.VarChar(100)
  medical_certificate                 String?              @db.VarChar(100)
  state_criminal_record_certificate   String?              @db.VarChar(100)
  federal_criminal_record_certificate String?              @db.VarChar(100)
  first_recommendation_letter         String?              @db.VarChar(100)
  second_recommendation_letter        String?              @db.VarChar(100)
  driver_license                      String?              @db.VarChar(100)
  signed_regulation                   String?              @db.VarChar(100)
  signed_contract                     String?              @db.VarChar(100)
  signed_confidential_letter          String?              @db.VarChar(100)
  signed_ethics_letter                String?              @db.VarChar(100)
  induction_manual                    String?              @db.VarChar(100)
  employee_documents                  employee_documents[]
}

model donation {
  donation_id      String           @id(map: "donation_pk") @db.Uuid
  donator_id       String           @db.Uuid
  donation_type_id String           @db.Uuid
  date             DateTime         @db.Date
  product          String           @db.VarChar(30)
  quantity         Decimal          @db.Decimal
  measurement      String           @db.VarChar(10)
  donation_type    donation_type    @relation(fields: [donation_type_id], references: [donation_type_id], onDelete: NoAction, onUpdate: NoAction, map: "donation_donation_type_fk")
  donator          donator          @relation(fields: [donator_id], references: [donator_id], onDelete: NoAction, onUpdate: NoAction, map: "donation_donator_fk")
  house_donation   house_donation[]
}

model donation_type {
  donation_type_id String     @id(map: "donation_type_pk") @db.Uuid
  name             String     @unique @db.VarChar(30)
  donation         donation[]
}

model donator {
  donator_id String     @id(map: "donator_pk") @db.Uuid
  name       String     @db.VarChar(100)
  donation   donation[]
}

model employee {
  employee_id                   String                          @id(map: "employee_pk") @db.Uuid
  house_id                      String                          @db.Uuid
  role_id                       String                          @db.Uuid
  name                          String                          @db.VarChar(50)
  surname                       String                          @db.VarChar(50)
  type                          String                          @db.VarChar(20)
  is_active                     Boolean
  email                         String                          @unique @db.VarChar(60)
  password                      String                          @db.VarChar(72)
  has_first_login               Boolean
  is_active_2fa                 Boolean                         @default(false)
  failed_login_attempts         Int                             @default(0)
  failed_2fa_attempts           Int                             @default(0)
  totp_secret                   String?                         @db.VarChar(32)
  curp                          String                          @unique @db.VarChar(18)
  rfc                           String?                         @unique @db.VarChar(13)
  birth_date                    DateTime?                       @db.Date
  picture                       String?                         @db.VarChar(150)
  start_date                    DateTime                        @db.Date
  end_date                      DateTime?                       @db.Date
  phone_number                  String?                         @db.VarChar(20)
  nss                           String?                         @unique @db.VarChar(11)
  bank_account                  String?                         @db.VarChar(18)
  salary                        String?                         @db.VarChar(72)
  blocked_until                 DateTime?                       @db.Timestamp(6)
  two_fa_blocked_until          DateTime?                       @db.Timestamp(6)
  temp_totp_secret              String?                         @db.VarChar
  temp_totp_secret_created_at   DateTime?                       @db.Timestamp(6)
  house                         house                           @relation(fields: [house_id], references: [house_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_house_fk")
  role                          role                            @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_role_fk")
  employee_address              employee_address[]
  employee_backup_code          employee_backup_code[]
  employee_documents            employee_documents[]
  employee_fault                employee_fault[]
  employee_inside_certification employee_inside_certification[]
  employee_personal_event       employee_personal_event[]
  employee_workday              employee_workday[]
  logs                          logs[]
  outside_certification         outside_certification[]
  psychological_evaluation      psychological_evaluation[]
  vacations_request             vacations_request[]
}

model employee_address {
  employee_address_id String   @id(map: "employee_address_pk") @db.Uuid
  employee_id         String   @db.Uuid
  url                 String   @db.VarChar(200)
  street              String?  @db.VarChar(200)
  municipio           String?  @db.VarChar(120)
  city                String?  @db.VarChar(100)
  postal_code         String?  @db.VarChar(10)
  date                DateTime @db.Timestamp(6)
  employee            employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_address_employee_fk")
}

model employee_backup_code {
  backup_code_id String   @id(map: "employee_backup_code_pk") @db.Uuid
  employee_id    String   @db.Uuid
  code           String   @unique @db.VarChar(10)
  employee       employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_backup_code_employee_fk")
}

model employee_documents {
  document_id String    @db.Uuid
  employee_id String    @db.Uuid
  url         String    @db.VarChar(100)
  documents   documents @relation(fields: [document_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_documents_documents_fk")
  employee    employee  @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_documents_employee_fk")

  @@id([document_id, employee_id], map: "employee_documents_pk")
}

model employee_fault {
  fault_id    String   @db.Uuid
  employee_id String   @db.Uuid
  employee    employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_fault_employee_fk")
  fault       fault    @relation(fields: [fault_id], references: [fault_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_fault_fault_fk")

  @@id([fault_id, employee_id], map: "employee_fault_pk")
}

model employee_inside_certification {
  inside_certification_id String                @db.Uuid
  employee_id             String                @db.Uuid
  date                    DateTime              @db.Date
  employee                employee              @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_inside_certification_employee_fk")
  inside_certifications   inside_certifications @relation(fields: [inside_certification_id], references: [inside_certification_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_inside_certification_inside_certifications_fk")

  @@id([inside_certification_id, employee_id], map: "employee_inside_certification_pk")
}

model employee_personal_event {
  personal_event_id String         @db.Uuid
  employee_id       String         @db.Uuid
  employee          employee       @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_personal_event_employee_fk")
  personal_event    personal_event @relation(fields: [personal_event_id], references: [personal_event_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_personal_event_personal_event_fk")

  @@id([personal_event_id, employee_id], map: "employee_personal_event_pk")
}

model employee_workday {
  workday_id  String   @db.Uuid
  employee_id String   @db.Uuid
  start       DateTime @db.Time(6)
  end         DateTime @db.Time(6)
  employee    employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_workday_employee_fk")
  workday     workday  @relation(fields: [workday_id], references: [workday_id], onDelete: NoAction, onUpdate: NoAction, map: "employee_workday_workday_fk")

  @@id([workday_id, employee_id], map: "employee_workday_pk")
}

model event_type {
  event_type_id  String           @id(map: "event_type_pk") @db.Uuid
  name           String           @unique @db.VarChar(30)
  global_event   global_event[]
  house_event    house_event[]
  personal_event personal_event[]
}

model fault {
  fault_id       String           @id(map: "fault_pk") @db.Uuid
  date           DateTime         @db.Date
  description    String
  employee_fault employee_fault[]
}

model global_event {
  global_event_id String     @id(map: "global_event_pk") @db.Uuid
  event_type_id   String     @db.Uuid
  date            DateTime   @db.Date
  start           DateTime   @db.Time(6)
  end             DateTime   @db.Time(6)
  name            String     @db.VarChar(70)
  description     String?
  is_free_day     Boolean
  event_type      event_type @relation(fields: [event_type_id], references: [event_type_id], onDelete: NoAction, onUpdate: NoAction, map: "global_event_event_type_fk")
}

model house {
  house_id       String           @id(map: "house_pk") @db.Uuid
  name           String           @unique @db.VarChar(60)
  location       String
  phone_number   String           @db.VarChar(15)
  description    String
  image          String           @db.VarChar(100)
  employee       employee[]
  house_donation house_donation[]
  house_event    house_event[]
}

model house_donation {
  house_donation_id String   @id(map: "house_donation_pk") @db.Uuid
  house_id          String   @db.Uuid
  donation_id       String   @db.Uuid
  quantity          Decimal  @db.Decimal
  date              DateTime @db.Date
  donation          donation @relation(fields: [donation_id], references: [donation_id], onDelete: NoAction, onUpdate: NoAction, map: "house_donation_donation_fk")
  house             house    @relation(fields: [house_id], references: [house_id], onDelete: NoAction, onUpdate: NoAction, map: "house_donation_house_fk")
}

model house_event {
  house_event_id String     @id(map: "house_event_pk") @db.Uuid
  event_type_id  String     @db.Uuid
  house_id       String     @db.Uuid
  date           DateTime   @db.Date
  start          DateTime   @db.Time(6)
  end            DateTime   @db.Time(6)
  name           String     @db.VarChar(70)
  description    String?
  event_type     event_type @relation(fields: [event_type_id], references: [event_type_id], onDelete: NoAction, onUpdate: NoAction, map: "house_event_event_type_fk")
  house          house      @relation(fields: [house_id], references: [house_id], onDelete: NoAction, onUpdate: NoAction, map: "house_event_house_fk")
}

model inside_certifications {
  inside_certification_id       String                          @id(map: "inside_certifications_pk") @db.Uuid
  name                          String                          @unique @db.VarChar(70)
  description                   String
  employee_inside_certification employee_inside_certification[]
}

model logs {
  log_id      String   @id(map: "logs_pk") @db.Uuid
  employee_id String   @db.Uuid
  moment      DateTime @db.Timestamp(6)
  action_id   String   @db.VarChar(8)
  affected    String?  @db.VarChar(120)
  ip_address  String   @db.VarChar(72)
  action      action   @relation(fields: [action_id], references: [action_id], onDelete: NoAction, onUpdate: NoAction, map: "logs_action_fk")
  employee    employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "logs_employee_fk")
}

model outside_certification {
  outside_certification_id String   @id(map: "outside_certification_pk") @db.Uuid
  employee_id              String   @db.Uuid
  file                     String   @db.VarChar(100)
  name                     String   @db.VarChar(70)
  employee                 employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "outside_certification_employee_fk")
}

model personal_event {
  personal_event_id       String                    @id(map: "personal_event_pk") @db.Uuid
  event_type_id           String                    @db.Uuid
  start                   DateTime                  @db.Timestamp(6)
  end                     DateTime                  @db.Timestamp(6)
  name                    String                    @db.VarChar(70)
  description             String
  employee_personal_event employee_personal_event[]
  event_type              event_type                @relation(fields: [event_type_id], references: [event_type_id], onDelete: NoAction, onUpdate: NoAction, map: "personal_event_event_type_fk")
}

model psychological_evaluation {
  psychological_evaluation_id String   @id(map: "psychological_evaluation_pk") @db.Uuid
  employee_id                 String   @db.Uuid
  file                        String   @db.VarChar(100)
  date                        DateTime @db.Date
  employee                    employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "psychological_evaluation_employee_fk")
}

model role {
  role_id  String     @id(map: "role_pk") @db.Uuid
  name     String     @unique @db.VarChar(50)
  employee employee[]
}

model vacations_request {
  vacations_request_id String   @id(map: "vacations_request_pk") @db.Uuid
  employee_id          String   @db.Uuid
  start                DateTime @db.Date
  end                  DateTime @db.Date
  status               Int
  feedback             String?
  employee             employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "vacations_request_employee_fk")
}

model workday {
  workday_id       String             @id(map: "workday_pk") @db.Uuid
  name             String             @unique @db.VarChar(9)
  employee_workday employee_workday[]
}
